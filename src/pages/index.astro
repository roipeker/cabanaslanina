const mapsHref='https://www.google.com/maps/place/Caba%C3%B1as+La+Ni%C3%B1a/@-34.6498786,-59.3895022,17z/data=!3m1!4b1!4m9!3m8!1s0x95bc73733aa84553:0xc60530ac4920e7d0!5m2!4m1!1i2!8m2!3d-34.649883!4d-59.3869273!16s%2Fg%2F1ptw7yz37?entry=ttu';
const legacyExterior='https://www.argentinaturismo.com.ar/laninia/img-cliente/2/05.jpg'; const legacyInterior='https://www.argentinaturismo.com.ar/laninia/img-cliente/2/25.jpg';
const pulperiaImage='https://www.paisturistico.com.ar/fotito/640/640/WH/grafica/multimedia/Ficha-0000000575-002-0000008790-001-G.jpg'; const parkImage='https://nw.mercedes.gob.ar/fotos/noticias/img-2378.jpg'; const trochaImage='https://nw.mercedes.gob.ar/fotos/noticias/img-1818.jpg';
const breakfastImages=['https://images.pexels.com/photos/4397247/pexels-photo-4397247.jpeg?auto=compress&cs=tinysrgb&w=1600','https://images.pexels.com/photos/27215764/pexels-photo-27215764.jpeg?auto=compress&cs=tinysrgb&w=1600','https://images.pexels.com/photos/17216071/pexels-photo-17216071.jpeg?auto=compress&cs=tinysrgb&w=1600'];
const stayNightImage='https://images.pexels.com/photos/19353429/pexels-photo-19353429.jpeg?auto=compress&cs=tinysrgb&w=1600'; const stayDiningImage='https://images.pexels.com/photos/28210542/pexels-photo-28210542.jpeg?auto=compress&cs=tinysrgb&w=1200';
const structuredData={'@context':'https://schema.org','@type':'LodgingBusiness',name:'Cabañas La Niña',url:'https://cabanaslanina.com/',telephone:'+54 2324 51-9213',address:{'@type':'PostalAddress',streetAddress:'Calle 151 entre 28 Bis y 30 Bis',addressLocality:'Mercedes',addressRegion:'Buenos Aires',postalCode:'B6600',addressCountry:'AR'},geo:{'@type':'GeoCoordinates',latitude:-34.649883,longitude:-59.3869273},petsAllowed:'Con consulta previa',aggregateRating:{'@type':'AggregateRating',ratingValue:'4.5',reviewCount:'260',bestRating:'5'}};
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="theme-color" content="#0f4b37"/><meta name="description" content="Cabañas La Niña: naturaleza, parque y descanso a pocos minutos del centro de Mercedes, Buenos Aires."/><meta property="og:type" content="website"/><meta property="og:locale" content="es_AR"/><meta property="og:title" content="Cabañas La Niña — Mercedes, Buenos Aires"/><meta property="og:description" content="Una escapada entre dos hectáreas de verde, a pocos minutos del centro de Mercedes."/><meta property="og:image" content={legacyExterior}/><link rel="canonical" href="https://roipeker.github.io/cabanaslanina/"/><link rel="icon" href={`${base}logo.svg`} type="image/svg+xml"/><link rel="stylesheet" href={`${base}guest-preview.css`}/><link rel="stylesheet" href={`${base}home-v3.css`}/><title>Cabañas La Niña — Escapadas en Mercedes, Buenos Aires</title><script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}/></head><body>
<header class="topbar"><div class="shell topbar-inner"><a class="brand" href="#inicio" aria-label="Cabañas La Niña, inicio"><img src={`${base}logo.svg`} alt="" width="62" height="48"/><span class="brand-copy"><strong>La Niña</strong><span>Mercedes · Buenos Aires</span></span></a><nav class="nav" aria-label="Principal"><a href="#lugar">El lugar</a><a href="#servicios">Servicios</a><a href="#desayuno">Desayuno</a><a href={`${base}guia/`}>Guía</a><a href={`${base}estadia/`}>Tu estadía</a><a href="#ubicacion">Ubicación</a><a class="nav-cta" href={phoneHref}>Consultar</a></nav></div></header><main>
<section class="hero" id="inicio"><div class="hero-media"><img src={legacyExterior} alt="Cabaña de ladrillo rodeada de parque en Cabañas La Niña" fetchpriority="high"/></div><div class="hero-mark" aria-hidden="true">LN</div><div class="shell hero-content"><div class="eyebrow">Mercedes · Provincia de Buenos Aires</div><h1>Volver al ritmo<br/><em>de la naturaleza.</em></h1><p class="hero-lede">Seis cabañas entre dos hectáreas de parque. Una escapada simple para descansar, compartir y estar un poco más lejos del ruido.</p><div class="hero-actions"><a class="button button-primary" href={phoneHref}>Consultar disponibilidad</a><a class="button button-ghost" href="#lugar">Conocer La Niña</a></div><div class="hero-meta"><div><small>Complejo</small><strong>6 cabañas</strong></div><div><small>Entorno</small><strong>2 hectáreas de parque</strong></div><div><small>Ubicación</small><strong>Mercedes, Buenos Aires</strong></div></div></div><aside class="hero-portal"><small><span class="live-dot"></span>Ahora en La Niña</small><strong>Tu pequeña base de campo.</strong><div class="hero-portal-grid"><div><small>Clima</small><span class="hero-weather-value" data-weather>—</span></div><div><small>Pileta</small><span>Verano</span></div><a href={`${base}estadia/`}><small>Huéspedes</small><span>Abrir guía →</span></a><a href={`${base}guia/`}><small>Este finde</small><span>Ver Mercedes →</span></a></div></aside></section>
<section class="trust-strip"><div class="shell trust-grid"><a class="rating" href={mapsHref} target="_blank" rel="noreferrer"><span class="stars">★★★★★</span><strong>4,5 en Google</strong><span>260 opiniones · ver ficha ↗</span></a><p>A pocos kilómetros del centro de Mercedes, con parque, pileta y espacio para bajar un cambio.</p></div></section>
<section class="home-quick"><div class="shell home-quick-grid"><a href={`${base}estadia/`}><small>Ya llegaste</small><strong>Guía práctica del huésped →</strong></a><div><small>Desayuno · horario a confirmar</small><strong>~ 08:30 — 11:30</strong></div><div><small>Pileta</small><strong>Temporada de verano</strong></div><a href={`${base}guia/tomas-jofre-domingo-alrededor-de-la-mesa/`}><small>Plan de domingo</small><strong>Tomás Jofré →</strong></a></div></section>
<section class="intro" id="lugar"><div class="shell intro-grid"><div class="section-kicker">Una pausa cerca</div><div><h2 class="display">Hay días que piden menos agenda y más verde.</h2><p class="intro-copy">La Niña es un pequeño complejo de cabañas en un entorno rural de Mercedes. El parque, la pileta, los espacios abiertos y las cabañas independientes hacen que el lugar funcione tanto para una escapada en pareja como para bajar un cambio en familia.</p></div></div></section>
<section class="visual-break" aria-label="Una mirada a Mercedes"><figure class="visual-main"><img src={pulperiaImage} alt="Pulpería histórica de Mercedes" loading="lazy"/><figcaption><span>01 · Oficios & memoria</span><strong>Historias que todavía tienen puerta abierta.</strong></figcaption></figure><figure class="visual-small visual-small-top"><img src={trochaImage} alt="Complejo Cultural La Trocha" loading="lazy"/><figcaption>La Trocha · patrimonio ferroviario</figcaption></figure><figure class="visual-small visual-small-bottom"><img src={parkImage} alt="Parque Independencia junto al río Luján" loading="lazy"/><figcaption>Parque Independencia · Río Luján</figcaption></figure><div class="visual-word" aria-hidden="true">MERCEDES</div></section>
<section class="story-grid"><div class="story-photo"><img src={legacyInterior} alt="Interior cálido de una cabaña de La Niña" loading="lazy"/></div><div class="story-panel"><div><div class="section-kicker section-kicker-light">Adentro</div><h2>Rústicas, cálidas y pensadas para quedarse.</h2><p>Espacios independientes con cocina, aire acondicionado, Wi‑Fi y parrilla. Lo necesario para hacer base, cocinar algo, descansar y volver al parque.</p></div></div></section>
<section class="features" id="servicios"><div class="shell"><div class="features-head"><div><div class="section-kicker">Lo esencial</div><h2 class="display">Más lugar para hacer menos.</h2></div><p class="features-note">Un complejo simple y de escala chica: verde, independencia y las comodidades necesarias para que el fin de semana no tenga demasiada agenda.</p></div><div class="feature-list"><article class="feature"><div class="num">01</div><h3>Parque</h3><p>Un predio amplio y parquizado para pasar el día afuera.</p></article><article class="feature"><div class="num">02</div><h3>Pileta</h3><p>Piscina al aire libre disponible durante la temporada de verano.</p></article><article class="feature"><div class="num">03</div><h3>Parrilla</h3><p>Las cabañas cuentan con un lugar propio para cocinar al fuego.</p></article><article class="feature"><div class="num">04</div><h3>Comodidad</h3><p>Wi‑Fi, cocina, estacionamiento y aire acondicionado.</p></article></div><aside class="pet-note"><div class="pet-mark" aria-hidden="true">🐾</div><div><div class="section-kicker">Venís con compañía</div><h3>Las mascotas también pueden escaparse.</h3><p>Recibimos mascotas con <strong>consulta previa</strong>. Avisanos antes de reservar para coordinar la estadía y asegurarnos de que funcione bien para todos.</p></div><a class="text-link" href={phoneHref}>Consultar antes de venir →</a></aside></div></section>
<section class="breakfast" id="desayuno"><div class="breakfast-gallery"><div class="breakfast-track" data-breakfast-track>{breakfastImages.map((src,i)=><figure><img src={src} alt={`Desayuno de La Niña — imagen conceptual ${i+1}`} loading="lazy"/></figure>)}</div><div class="breakfast-controls"><button type="button" aria-label="Foto anterior" data-breakfast-prev>←</button><span class="breakfast-progress" data-breakfast-count>01 / 03</span><button type="button" aria-label="Foto siguiente" data-breakfast-next>→</button></div><div class="breakfast-stamp" aria-hidden="true"><span>LA NIÑA</span><strong>AM</strong><small>sin apuro</small></div></div><div class="breakfast-copy"><div class="section-kicker">Opcional · hecho en casa</div><h2>Mañanas<br/><em>sin apuro.</em></h2><p class="breakfast-lede">Si querés, podés sumar desayuno a la estadía: panadería hecha en casa, café, té y jugo de naranja, además de yogur griego con frutas y frutos secos.</p><div class="breakfast-menu"><span>Panadería artesanal</span><span>Café & té</span><span>Jugo de naranja</span><span>Yogur griego · frutas · frutos secos</span></div><p class="breakfast-note">Un pequeño ritual para quedarse un rato más. <strong>Se solicita aparte de la estadía.</strong></p><span class="provisional">Horario tentativo: 08:30—11:30 · a corroborar</span></div></section>
<section class="discover" id="descubrir"><div class="shell discover-head"><div><div class="section-kicker">Cuaderno de viaje · La Niña</div><h2 class="display">Mercedes también es parte de la escapada.</h2></div><div class="discover-intro"><p>No una lista de atracciones: una colección de mesas, historias y lugares que ayudan a mirar el paisaje alrededor de La Niña con otros ojos.</p><a class="text-link" href={`${base}guia/`}>Abrir el cuaderno de Mercedes →</a></div></div><div class="shell editorial-grid">{featuredStories.map((story,index)=><article class:list={["editorial-card",index===0&&"editorial-card-lead"]}><a class="editorial-media" href={`${base}guia/${story.slug}/`}><img src={story.image} alt={story.imageAlt} loading="lazy"/><span class="editorial-index">0{index+1}</span></a><div class="editorial-copy"><div class="section-kicker">{story.eyebrow}</div><h3><a href={`${base}guia/${story.slug}/`}>{story.title}</a></h3><p>{story.dek}</p><a class="text-link" href={`${base}guia/${story.slug}/`}>Leer historia →</a></div></article>)}</div></section>
<section class="now-card"><div class="shell now-grid"><div class="now-date"><span>11—13</span><small>SEP · 2026</small></div><div><div class="section-kicker section-kicker-light">Próximo en Mercedes</div><h2>51ª Fiesta Nacional del Salame Quintero</h2><p>Tres días en el Parque Municipal Independencia con productores, gastronomía, actividades y música en vivo. Una buena excusa para hacer del viaje un fin de semana.</p></div><div class="now-actions"><a class="button button-primary" href={`${base}guia/fiesta-salame-quintero-2026/`}>Planear la visita</a><a class="text-link text-link-light" href="https://fiestadelsalame.mercedes.gob.ar/" target="_blank" rel="noreferrer">Sitio oficial ↗</a></div></div></section>
<section class="guest-preview"><div class="guest-preview-media"><figure class="guest-night"><img src={stayNightImage} alt="Restaurante cálido de noche — imagen conceptual" loading="lazy"/></figure><figure class="guest-dining"><img src={stayDiningImage} alt="Cena al aire libre con luces cálidas — imagen conceptual" loading="lazy"/></figure></div><div class="guest-preview-copy"><div class="section-kicker">Cuando ya estás acá</div><h2>Desayuno, compras, cena y una copa. Todo en un lugar.</h2><p>Armamos una guía práctica para huéspedes con rutas directas desde La Niña a supermercados, restaurantes, bares, el centro y Tomás Jofré, además de datos útiles durante la estadía.</p><div class="guest-mini"><span><small>Comer</small><strong>PIRA · Laurino · La Cuadra</strong></span><span><small>Comprar</small><strong>Supermercados y centro</strong></span><span><small>Resolver</small><strong>Farmacias · combustible · emergencias</strong></span></div><a class="button button-dark" href={`${base}estadia/`}>Abrir guía de la estadía</a></div></section>
<section class="proof"><div class="shell"><div class="proof-head"><div><div class="section-kicker section-kicker-light">Lo dicen quienes vinieron</div><h2>La mejor prueba es querer volver.</h2></div><p>La ficha de Google muestra actualmente 4,5 sobre 5 con 260 opiniones. También seguimos lo que cuentan huéspedes en otros sitios para entender qué recuerdan del lugar.</p></div><div class="review-grid"><article class="review-card"><div class="review-stars">★★★★★</div><blockquote>“Excelente lugar rodeado de naturaleza, paz atendido por sus dueños muy cordiales.”</blockquote><small>Patricia Frasch · reseña visible en Google</small></article><article class="review-card"><div class="review-stars">★★★★★</div><blockquote>“Bellísimo lugar… la piscina es hermosa, el parque muy bien cuidado.”</blockquote><small>Carmen E · Tripadvisor · marzo 2026</small></article><article class="review-card"><div class="review-stars">★★★★★</div><blockquote>“Un lugar bello para descansar… y por favor el desayuno.”</blockquote><small>Laura Hebe C · Tripadvisor · enero 2025</small></article></div><div class="proof-links"><a href={mapsHref} target="_blank" rel="noreferrer">Ver las 260 opiniones en Google ↗</a><a href="https://www.tripadvisor.com.ar/Hotel_Review-g312750-d15528549-Reviews-Cabanas_la_Nina-Mercedes_Province_of_Buenos_Aires_Central_Argentina.html" target="_blank" rel="noreferrer">Ver Tripadvisor ↗</a></div></div></section>
<section class="mentioned"><div class="shell mentioned-grid"><div><div class="section-kicker">La Niña en la web</div><h2 class="display">Una presencia construida con los años.</h2></div><div class="mentioned-list"><a href="https://www.google.com.ar/travel/hotels/entity/ChkI0M-DycSVzILGARoML2cvMXB0dzd5ejM3EAE" target="_blank" rel="noreferrer"><small>Google Hoteles</small><strong>4,5 · 260 opiniones · ficha activa</strong></a><a href="https://www.tripadvisor.com.ar/Hotel_Review-g312750-d15528549-Reviews-Cabanas_la_Nina-Mercedes_Province_of_Buenos_Aires_Central_Argentina.html" target="_blank" rel="noreferrer"><small>Tripadvisor</small><strong>Entre los alojamientos especiales de Mercedes</strong></a><a href="https://www.argentinaturismo.com.ar/mercedesbuenosaires/cabanas.html" target="_blank" rel="noreferrer"><small>Argentina Turismo</small><strong>Referenciada en el directorio de cabañas de Mercedes</strong></a><a href="https://www.argentinaturismo.com.ar/tomasjofre/alojamientos.php" target="_blank" rel="noreferrer"><small>Tomás Jofré</small><strong>También aparece en listados de alojamiento de la zona</strong></a></div></div></section>
<section class="quote"><div class="shell"><div class="quote-monogram">LN · 34°38′S</div><blockquote>“Lo suficientemente cerca para escaparse. Lo suficientemente tranquilo para sentir que te fuiste.”</blockquote><p>Cabañas La Niña · Mercedes</p></div></section>
<section class="location" id="ubicacion"><div class="shell location-grid"><div><div class="section-kicker">Mercedes, Buenos Aires</div><h2 class="display location-title">Campo sin irse demasiado lejos.</h2><p>La Niña está en un entorno rural de Mercedes, a pocos kilómetros del centro. Una base tranquila para descansar, recorrer la ciudad y reservar un domingo largo alrededor de una mesa en Tomás Jofré.</p><a class="text-link" href={`${base}guia/tomas-jofre-domingo-alrededor-de-la-mesa/`}>Descubrir Tomás Jofré →</a></div><div class="address-card"><small>Cómo llegar</small><strong>Calle 151 entre 28 Bis y 30 Bis<br/>Mercedes, Buenos Aires</strong><a href={mapsHref} target="_blank" rel="noreferrer">Abrir la ficha exacta en Google Maps ↗</a></div></div></section>
<section class="contact" id="contacto"><div class="shell"><div class="contact-grid"><div><div class="section-kicker section-kicker-light">Tu próxima pausa</div><h2 class="display contact-title">¿Cuándo te querés escapar?</h2></div><div><p>Para disponibilidad, mascotas y consultas, hablá directamente con La Niña.</p><div class="contact-actions"><a class="button button-primary" href={phoneHref}>Llamar · {phoneDisplay}</a></div></div></div><footer class="footer"><div><img src={`${base}logo.svg`} alt="Cabañas La Niña"/><div class="footer-place">Mercedes · Provincia de Buenos Aires · Argentina</div></div><div>Campo · historias · descanso</div></footer></div></section></main>
<script is:inline>
(()=>{const t=document.querySelector('[data-breakfast-track]');if(t){const slides=[...t.children],count=document.querySelector('[data-breakfast-count]');let i=0,timer;const go=n=>{i=(n+slides.length)%slides.length;t.scrollTo({left:t.clientWidth*i,behavior:'smooth'});if(count)count.textContent=`${String(i+1).padStart(2,'0')} / ${String(slides.length).padStart(2,'0')}`};document.querySelector('[data-breakfast-prev]')?.addEventListener('click',()=>go(i-1));document.querySelector('[data-breakfast-next]')?.addEventListener('click',()=>go(i+1));const start=()=>{if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;clearInterval(timer);timer=setInterval(()=>go(i+1),4800)};t.addEventListener('scroll',()=>{const n=Math.round(t.scrollLeft/Math.max(1,t.clientWidth));if(n!==i){i=n;if(count)count.textContent=`${String(i+1).padStart(2,'0')} / ${String(slides.length).padStart(2,'0')}`}}, {passive:true});t.addEventListener('pointerdown',()=>clearInterval(timer));t.addEventListener('pointerup',start);start()}
const targets=document.querySelectorAll('[data-weather]');if(targets.length){fetch('https://api.open-meteo.com/v1/forecast?latitude=-34.649883&longitude=-59.3869273&current=temperature_2m,weather_code&timezone=America%2FArgentina%2FBuenos_Aires').then(r=>r.json()).then(d=>{const c=d.current||{};const code=c.weather_code;const label=code===0?'Despejado':code<=3?'Algo nublado':code<=67?'Lluvia':code<=82?'Chaparrones':'Variable';targets.forEach(el=>el.textContent=`${Math.round(c.temperature_2m)}° · ${label}`)}).catch(()=>targets.forEach(el=>el.textContent='Mercedes · ahora'))}
})();
</script></body></html>