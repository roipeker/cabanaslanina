---
import '../../styles/global.css';
import { guideStories } from '../../data/guide';

export function getStaticPaths() {
  return guideStories.map((story) => ({ params: { slug: story.slug }, props: { story } }));
}

const { story } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteUrl = `https://roipeker.github.io/cabanaslanina/guia/${story.slug}/`;
const phoneHref = 'tel:+542324519213';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: story.title,
  description: story.dek,
  image: story.image,
  datePublished: story.published,
  dateModified: story.updated,
  author: { '@type': 'Organization', name: 'Cabañas La Niña' },
  publisher: { '@type': 'Organization', name: 'Cabañas La Niña' },
  mainEntityOfPage: siteUrl,
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#203d2d" />
    <meta name="description" content={story.dek} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={`${story.title} — Guía La Niña`} />
    <meta property="og:description" content={story.dek} />
    <meta property="og:image" content={story.image} />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" href={`${base}logo.svg`} type="image/svg+xml" />
    <title>{story.title} — Guía La Niña</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="guide-page">
    <header class="guide-topbar">
      <div class="shell topbar-inner">
        <a class="brand brand-dark" href={base} aria-label="Cabañas La Niña, inicio">
          <img src={`${base}logo.svg`} alt="" width="62" height="48" />
          <span class="brand-copy"><strong>La Niña</strong><span>Mercedes · Buenos Aires</span></span>
        </a>
        <nav class="nav nav-dark" aria-label="Guía">
          <a href={`${base}#lugar`}>Las cabañas</a>
          <a href={`${base}guia/`}>Guía</a>
          <a class="nav-cta" href={phoneHref}>Consultar</a>
        </nav>
      </div>
    </header>

    <main>
      <article>
        <header class="article-head shell">
          <a class="back-link" href={`${base}guia/`}>← Descubrir Mercedes</a>
          <div class="section-kicker">{story.eyebrow}</div>
          <h1>{story.title}</h1>
          <p class="article-dek">{story.dek}</p>
        </header>

        <figure class="article-hero">
          <img src={story.image} alt={story.imageAlt} fetchpriority="high" />
          {story.imageCredit && <figcaption>{story.imageCreditUrl ? <a href={story.imageCreditUrl} target="_blank" rel="noreferrer">{story.imageCredit} ↗</a> : story.imageCredit}</figcaption>}
        </figure>

        <div class="article-layout shell">
          <aside class="article-aside">
            {story.facts?.map((fact) => <div><small>{fact.label}</small><strong>{fact.value}</strong></div>)}
            {story.mapUrl && <a class="text-link" href={story.mapUrl} target="_blank" rel="noreferrer">Ver en Google Maps ↗</a>}
          </aside>
          <div class="article-body">
            {story.body.map((paragraph) => <p>{paragraph}</p>)}

            <section class="article-sources">
              <div class="section-kicker">Fuentes & para seguir</div>
              <ul>
                {story.sources.map((source) => <li><a href={source.url} target="_blank" rel="noreferrer">{source.label} ↗</a></li>)}
              </ul>
              <p class="source-note">Guía editorial en desarrollo. Verificamos datos con fuentes institucionales y periodísticas y revisamos información práctica antes de publicarla como recomendación.</p>
            </section>
          </div>
        </div>
      </article>

      <section class="stay-cta">
        <div class="shell stay-cta-grid">
          <div>
            <div class="section-kicker">Hacé base en Mercedes</div>
            <h2>Después de recorrer, volver al verde.</h2>
          </div>
          <div>
            <p>La Niña está a pocos minutos del centro, en un predio de dos hectáreas. Una forma tranquila de convertir el paseo en escapada.</p>
            <a class="button button-primary" href={phoneHref}>Consultar disponibilidad</a>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
