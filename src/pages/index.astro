---
import '../styles/global.css';
import { featuredStories } from '../data/guide';
const base=import.meta.env.BASE_URL; const phoneDisplay='+54 2324 51-9213'; const phoneHref='tel:+542324519213';
const mapsHref='https://www.google.com/maps/place/Caba%C3%B1as+La+Ni%C3%B1a/@-34.6498786,-59.3895022,17z/data=!3m1!4b1!4m9!3m8!1s0x95bc73733aa84553:0xc60530ac4920e7d0!5m2!4m1!1i2!8m2!3d-34.649883!4d-59.3869273!16s%2Fg%2F1ptw7yz37?entry=ttu';
const legacyExterior='https://www.argentinaturismo.com.ar/laninia/img-cliente/2/05.jpg'; const legacyInterior='https://www.argentinaturismo.com.ar/laninia/img-cliente/2/25.jpg';
const pulperiaImage='https://www.paisturistico.com.ar/fotito/640/640/WH/grafica/multimedia/Ficha-0000000575-002-0000008790-001-G.jpg'; const parkImage='https://nw.mercedes.gob.ar/fotos/noticias/img-2378.jpg'; const trochaImage='https://nw.mercedes.gob.ar/fotos/noticias/img-1818.jpg';
const breakfastImage='https://images.pexels.com/photos/4397247/pexels-photo-4397247.jpeg?auto=compress&cs=tinysrgb&w=1600'; const breakfastSpreadImage='https://images.pexels.com/photos/27215764/pexels-photo-27215764.jpeg?auto=compress&cs=tinysrgb&w=1200';
const stayNightImage='https://images.pexels.com/photos/19353429/pexels-photo-19353429.jpeg?auto=compress&cs=tinysrgb&w=1600'; const stayDiningImage='https://images.pexels.com/photos/28210542/pexels-photo-28210542.jpeg?auto=compress&cs=tinysrgb&w=1200';
const structuredData={'@context':'https://schema.org','@type':'LodgingBusiness',name:'Cabañas La Niña',url:'https://cabanaslanina.com/',telephone:'+54 2324 51-9213',address:{'@type':'PostalAddress',streetAddress:'Calle 151 entre 28 Bis y 30 Bis',addressLocality:'Mercedes',addressRegion:'Buenos Aires',postalCode:'B6600',addressCountry:'AR'},geo:{'@type':'GeoCoordinates',latitude:-34.649883,longitude:-59.3869273},petsAllowed:'Con consulta previa'};
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="theme-color" content="#0f4b37"/><meta name="description" content="Cabañas La Niña: naturaleza, parque y descanso a pocos minutos del centro de Mercedes, Buenos Aires."/><meta property="og:type" content="website"/><meta property="og:locale" content="es_AR"/><meta property="og:title" content="Cabañas La Niña — Mercedes, Buenos Aires"/><meta property="og:description" content="Una escapada entre dos hectáreas de verde, a pocos minutos del centro de Mercedes."/><meta property="og:image" content={legacyExterior}/><link rel="canonical" href="https://roipeker.github.io/cabanaslanina/"/><link rel="icon" href={`${base}logo.svg`} type="image/svg+xml"/><link rel="stylesheet" href={`${base}guest-preview.css`}/><title>Cabañas La Niña — Escapadas en Mercedes, Buenos Aires</title><script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}/></head><body>
<header class="topbar"><div class="shell topbar-inner"><a class="brand" href="#inicio" aria-label="Cabañas La Niña, inicio"><img src={`${base}logo.svg`} alt="" width="62" height="48"/><span class="brand-copy"><strong>La Niña</strong><span>Mercedes · Buenos Aires</span></span></a><nav class="nav" aria-label="Principal"><a href="#lugar">El lugar</a><a href="#servicios">Servicios</a><a href="#desayuno">Desayuno</a><a href={`${base}guia/`}>Guía</a><a href={`${base}estadia/`}>Tu estadía</a><a href="#ubicacion">Ubicación</a><a class="nav-cta" href={phoneHref}>Consultar</a></nav></div></header><main>
<section class="hero" id="inicio"><div class="hero-media"><img src={legacyExterior} alt="Cabaña de ladrillo rodeada de parque en Cabañas La Niña" fetchpriority="high"/></div><div class="hero-mark" aria-hidden="true">LN</div><div class="shell hero-content"><div class="eyebrow">Mercedes · Provincia de Buenos Aires</div><h1>Volver al ritmo<br/><em>de la naturaleza.</em></h1><p class="hero-lede">Seis cabañas entre dos hectáreas de parque. Una escapada simple para descansar, compartir y estar un poco más lejos del ruido.</p><div class="hero-actions"><a class="button button-primary" href={phoneHref}>Consultar disponibilidad</a><a class="button button-ghost" href="#lugar">Conocer La Niña</a></div><div class="hero-meta"><div><small>Complejo</small><strong>6 cabañas</strong></div><div><small>Entorno</small><strong>2 hectáreas de parque</strong></div><div><small>Ubicación</small><strong>Mercedes, Buenos Aires</strong></div></div></div></section>
<section class="trust-strip"><div class="shell trust-grid"><a class="rating" href={mapsHref} target="_blank" rel="noreferrer"><span class="stars">★★★★★</span><strong>4,5 en Google</strong><span>más de 250 opiniones · ver ficha ↗</span></a><p>A pocos kilómetros del centro de Mercedes, con parque, pileta y espacio para bajar un cambio.</p></div></section>
<section class="intro" id="lugar"><div class="shell intro-grid"><div class="section-kicker">Una pausa cerca</div><div><h2 class="display">Hay días que piden menos agenda y más verde.</h2><p class="intro-copy">La Niña es un pequeño complejo de cabañas en un entorno rural de Mercedes. El parque, la pileta, los espacios abiertos y las cabañas independientes hacen que el lugar funcione tanto para una escapada en pareja como para bajar un cambio en familia.</p></div></div></section>
<section class="visual-break" aria-label="Una mirada a Mercedes"><figure class="visual-main"><img src={pulperiaImage} alt="Pulpería histórica de Mercedes" loading="lazy"/><figcaption><span>01 · Oficios & memoria</span><strong>Historias que todavía tienen puerta abierta.</strong></figcaption></figure><figure class="visual-small visual-small-top"><img src={trochaImage} alt="Complejo Cultural La Trocha" loading="lazy"/><figcaption>La Trocha · patrimonio ferroviario</figcaption></figure><figure class="visual-small visual-small-bottom"><img src={parkImage} alt="Parque Independencia junto al río Luján" loading="lazy"/><figcaption>Parque Independencia · Río Luján</figcaption></figure><div class="visual-word" aria-hidden="true">MERCEDES</div></section>
<section class="story-grid"><div class="story-photo"><img src={legacyInterior} alt="Interior cálido de una cabaña de La Niña" loading="lazy"/></div><div class="story-panel"><div><div class="section-kicker section-kicker-light">Adentro</div><h2>Rústicas, cálidas y pensadas para quedarse.</h2><p>Espacios independientes con cocina, aire acondicionado, Wi‑Fi y parrilla. Lo necesario para hacer base, cocinar algo, descansar y volver al parque.</p></div></div></section>
<section class="features" id="servicios"><div class="shell"><div class="features-head"><div><div class="section-kicker">Lo esencial</div><h2 class="display">Más lugar para hacer menos.</h2></div><p class="features-note">Un complejo simple y de escala chica: verde, independencia y las comodidades necesarias para que el fin de semana no tenga demasiada agenda.</p></div><div class="feature-list"><article class="feature"><div class="num">01</div><h3>Parque</h3><p>Un predio amplio y parquizado para pasar el día afuera.</p></article><article class="feature"><div class="num">02</div><h3>Pileta</h3><p>Espacio de piscina al aire libre dentro del complejo.</p></article><article class="feature"><div class="num">03</div><h3>Parrilla</h3><p>Las cabañas cuentan con un lugar propio para cocinar al fuego.</p></article><article class="feature"><div class="num">04</div><h3>Comodidad</h3><p>Wi‑Fi, cocina, estacionamiento y aire acondicionado.</p></article></div><aside class="pet-note"><div class="pet-mark" aria-hidden="true">🐾</div><div><div class="section-kicker">Venís con compañía</div><h3>Las mascotas también pueden escaparse.</h3><p>Recibimos mascotas con <strong>consulta previa</strong>. Avisanos antes de reservar para coordinar la estadía y asegurarnos de que funcione bien para todos.</p></div><a class="text-link" href={phoneHref}>Consultar antes de venir →</a></aside></div></section>
<section class="breakfast" id="desayuno"><div class="breakfast-gallery"><figure class="breakfast-main"><img src={breakfastImage} alt="Desayuno con yogur, frutas y frutos secos — imagen conceptual" loading="lazy"/></figure><figure class="breakfast-detail"><img src={breakfastSpreadImage} alt="Mesa de desayuno con café, panadería, frutas y jugo — imagen conceptual" loading="lazy"/></figure><div class="breakfast-stamp" aria-hidden="true"><span>LA NIÑA</span><strong>AM</strong><small>sin apuro</small></div></div><div class="breakfast-copy"><div class="section-kicker">Opcional · hecho en casa</div><h2>Mañanas<br/><em>sin apuro.</em></h2><p class="breakfast-lede">Si querés, podés sumar desayuno a la estadía: panadería hecha en casa, café, té y jugo de naranja, además de yogur griego con frutas y frutos secos.</p><div class="breakfast-menu"><span>Panadería artesanal</span><span>Café & té</span><span>Jugo de naranja</span><span>Yogur griego · frutas · frutos secos</span></div><p class="breakfast-note">Un pequeño ritual para quedarse un rato más. <strong>Se solicita aparte de la estadía.</strong></p></div></section>
<section class="discover" id="descubrir"><div class="shell discover-head"><div><div class="section-kicker">Cuaderno de viaje · La Niña</div><h2 class="display">Mercedes también es parte de la escapada.</h2></div><div class="discover-intro"><p>No una lista de atracciones: una colección de mesas, historias y lugares que ayudan a mirar el paisaje alrededor de La Niña con otros ojos.</p><a class="text-link" href={`${base}guia/`}>Abrir el cuaderno de Mercedes →</a></div></div><div class="shell editorial-grid">{featuredStories.map((story,index)=><article class:list={["editorial-card",index===0&&"editorial-card-lead"]}><a class="editorial-media" href={`${base}guia/${story.slug}/`}><img src={story.image} alt={story.imageAlt} loading="lazy"/><span class="editorial-index">0{index+1}</span></a><div class="editorial-copy"><div class="section-kicker">{story.eyebrow}</div><h3><a href={`${base}guia/${story.slug}/`}>{story.title}</a></h3><p>{story.dek}</p><a class="text-link" href={`${base}guia/${story.slug}/`}>Leer historia →</a></div></article>)}</div></section>
<section class="now-card"><div class="shell now-grid"><div class="now-date"><span>11—13</span><small>SEP · 2026</small></div><div><div class="section-kicker section-kicker-light">Próximo en Mercedes</div><h2>51ª Fiesta Nacional del Salame Quintero</h2><p>Tres días en el Parque Municipal Independencia con productores, gastronomía, actividades y música en vivo. Una buena excusa para hacer del viaje un fin de semana.</p></div><div class="now-actions"><a class="button button-primary" href={`${base}guia/fiesta-salame-quintero-2026/`}>Planear la visita</a><a class="text-link text-link-light" href="https://fiestadelsalame.mercedes.gob.ar/" target="_blank" rel="noreferrer">Sitio oficial ↗</a></div></div></section>
<section class="guest-preview"><div class="guest-preview-media"><figure class="guest-night"><img src={stayNightImage} alt="Restaurante cálido de noche — imagen conceptual" loading="lazy"/></figure><figure class="guest-dining"><img src={stayDiningImage} alt="Cena al aire libre con luces cálidas — imagen conceptual" loading="lazy"/></figure></div><div class="guest-preview-copy"><div class="section-kicker">Cuando ya estás acá</div><h2>Desayuno, compras, cena y una copa. Todo en un lugar.</h2><p>Armamos una guía práctica para huéspedes con rutas directas desde La Niña a supermercados, restaurantes, bares, el centro y Tomás Jofré, además de datos útiles durante la estadía.</p><div class="guest-mini"><span><small>Comer</small><strong>PIRA · Laurino · La Cuadra</strong></span><span><small>Comprar</small><strong>Supermercados y centro</strong></span><span><small>Resolver</small><strong>Farmacias · combustible · emergencias</strong></span></div><a class="button button-dark" href={`${base}estadia/`}>Abrir guía de la estadía</a></div></section>
<section class="quote"><div class="shell"><div class="quote-monogram">LN · 34°38′S</div><blockquote>“Lo suficientemente cerca para escaparse. Lo suficientemente tranquilo para sentir que te fuiste.”</blockquote><p>Cabañas La Niña · Mercedes</p></div></section>
<section class="location" id="ubicacion"><div class="shell location-grid"><div><div class="section-kicker">Mercedes, Buenos Aires</div><h2 class="display location-title">Campo sin irse demasiado lejos.</h2><p>La Niña está en un entorno rural de Mercedes, a pocos kilómetros del centro. Una base tranquila para descansar, recorrer la ciudad y reservar un domingo largo alrededor de una mesa en Tomás Jofré.</p><a class="text-link" href={`${base}guia/tomas-jofre-domingo-alrededor-de-la-mesa/`}>Descubrir Tomás Jofré →</a></div><div class="address-card"><small>Cómo llegar</small><strong>Calle 151 entre 28 Bis y 30 Bis<br/>Mercedes, Buenos Aires</strong><a href={mapsHref} target="_blank" rel="noreferrer">Abrir la ficha exacta en Google Maps ↗</a></div></div></section>
<section class="contact" id="contacto"><div class="shell"><div class="contact-grid"><div><div class="section-kicker section-kicker-light">Tu próxima pausa</div><h2 class="display contact-title">¿Cuándo te querés escapar?</h2></div><div><p>Para disponibilidad, mascotas y consultas, hablá directamente con La Niña.</p><div class="contact-actions"><a class="button button-primary" href={phoneHref}>Llamar · {phoneDisplay}</a></div></div></div><footer class="footer"><div><img src={`${base}logo.svg`} alt="Cabañas La Niña"/><div class="footer-place">Mercedes · Provincia de Buenos Aires · Argentina</div></div><div>Campo · historias · descanso</div></footer></div></section></main></body></html>