---
import '../../styles/global.css';
import { guideStories } from '../../data/guide';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#203d2d" />
    <meta name="description" content="Historias, lugares y planes para descubrir Mercedes, Buenos Aires, desde Cabañas La Niña." />
    <link rel="canonical" href="https://roipeker.github.io/cabanaslanina/guia/" />
    <link rel="icon" href={`${base}logo.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href={`${base}guide-v2.css`} />
    <title>Descubrí Mercedes — Guía La Niña</title>
  </head>
  <body class="guide-page">
    <header class="guide-topbar">
      <div class="shell topbar-inner">
        <a class="brand brand-dark" href={base} aria-label="Cabañas La Niña, inicio">
          <img src={`${base}logo.svg`} alt="" width="62" height="48" />
          <span class="brand-copy"><strong>La Niña</strong><span>Mercedes · Buenos Aires</span></span>
        </a>
        <nav class="nav nav-dark" aria-label="Guía">
          <a href={`${base}#lugar`}>Las cabañas</a>
          <a href={`${base}guia/`}>Guía</a>
          <a class="nav-cta" href="tel:+542324519213">Consultar</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="guide-index-head shell">
        <div class="section-kicker">Guía La Niña · Mercedes</div>
        <h1>El lugar empieza mucho antes de llegar a la cabaña.</h1>
        <p>Historias, sabores, naturaleza y momentos para entender un poco mejor Mercedes y armar una escapada con algo para recordar.</p>
      </section>

      <section class="guide-grid shell" aria-label="Historias de Mercedes">
        {guideStories.map((story, index) => (
          <article class:list={["guide-card", index === 0 && "guide-card-featured"]}>
            <a class="guide-card-image" href={`${base}guia/${story.slug}/`}>
              <img src={story.image} alt={story.imageAlt} loading={index < 2 ? 'eager' : 'lazy'} />
            </a>
            <div class="guide-card-copy">
              <div class="section-kicker">{story.eyebrow}</div>
              <h2><a href={`${base}guia/${story.slug}/`}>{story.title}</a></h2>
              <p>{story.dek}</p>
              <a class="text-link" href={`${base}guia/${story.slug}/`}>Leer historia →</a>
            </div>
          </article>
        ))}
      </section>
    </main>
  </body>
</html>
