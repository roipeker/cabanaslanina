 {src:exterior,label:'El parque',copy:'Dos hectáreas de verde alrededor de seis cabañas.'},
 {src:interior,label:'Las cabañas',copy:'Espacios independientes, cálidos y simples para hacer base.'},
 {src:'https://www.argentinaturismo.com.ar/laninia/img-cliente/2/12.jpg',label:'Afuera',copy:'Parque, aire libre y tiempo sin demasiada agenda.'},
 {src:'https://www.argentinaturismo.com.ar/laninia/img-cliente/2/18.jpg',label:'Adentro',copy:'Cocina, Wi-Fi, aire acondicionado y parrilla.'}
];
const breakfastImages=['https://images.pexels.com/photos/4397247/pexels-photo-4397247.jpeg?auto=compress&cs=tinysrgb&w=1600','https://images.pexels.com/photos/27215764/pexels-photo-27215764.jpeg?auto=compress&cs=tinysrgb&w=1600','https://images.pexels.com/photos/17216071/pexels-photo-17216071.jpeg?auto=compress&cs=tinysrgb&w=1600'];
const structuredData={'@context':'https://schema.org','@type':'LodgingBusiness',name:'Cabañas La Niña',url:'https://cabanaslanina.com/',telephone:'+54 2324 51-9213',address:{'@type':'PostalAddress',streetAddress:'Calle 151 entre 28 Bis y 30 Bis',addressLocality:'Mercedes',addressRegion:'Buenos Aires',postalCode:'B6600',addressCountry:'AR'},geo:{'@type':'GeoCoordinates',latitude:-34.649883,longitude:-59.3869273},petsAllowed:'Con consulta previa',aggregateRating:{'@type':'AggregateRating',ratingValue:'4.5',reviewCount:'260',bestRating:'5'}};
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="theme-color" content="#0f4b37"/><meta name="description" content="Cabañas La Niña: seis cabañas entre dos hectáreas de parque en Mercedes, Buenos Aires."/><meta property="og:type" content="website"/><meta property="og:locale" content="es_AR"/><meta property="og:title" content="Cabañas La Niña — Mercedes, Buenos Aires"/><meta property="og:image" content={exterior}/><link rel="canonical" href="https://roipeker.github.io/cabanaslanina/"/><link rel="icon" href={`${base}logo.svg`} type="image/svg+xml"/><link rel="stylesheet" href={`${base}guest-preview.css`}/><link rel="stylesheet" href={`${base}home-v3.css`}/><link rel="stylesheet" href={`${base}home-v4.css`}/><title>Cabañas La Niña — Escapadas en Mercedes</title><script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}/></head><body>
<header class="topbar"><div class="shell topbar-inner"><a class="brand" href="#inicio"><img src={`${base}logo.svg`} alt="" width="62" height="48"/><span class="brand-copy"><strong>La Niña</strong><span>Mercedes · Buenos Aires</span></span></a><nav class="nav"><a href="#lugar">El lugar</a><a href="#servicios">Servicios</a><a href="#desayuno">Desayuno</a><a href={`${base}guia/`}>Mercedes</a><a href={`${base}estadia/`}>Tu estadía</a><a class="nav-cta" href={whatsappHref} target="_blank" rel="noreferrer">WhatsApp</a></nav></div></header><main>
<section class="hero" id="inicio"><div class="hero-media"><img src={exterior} alt="Cabaña de ladrillo rodeada de parque en Cabañas La Niña" fetchpriority="high"/></div><div class="hero-mark" aria-hidden="true">LN</div><div class="shell hero-content"><div class="eyebrow">Mercedes · Provincia de Buenos Aires</div><h1>Volver al ritmo<br/><em>de la naturaleza.</em></h1><p class="hero-lede">Seis cabañas entre dos hectáreas de parque. Una escapada simple para descansar, compartir y estar un poco más lejos del ruido.</p><div class="hero-actions"><a class="button button-primary" href={whatsappHref} target="_blank" rel="noreferrer">Consultar por WhatsApp</a><a class="button button-ghost" href="#lugar">Conocer La Niña</a></div><div class="hero-meta"><div><small>Complejo</small><strong>6 cabañas</strong></div><div><small>Entorno</small><strong>2 hectáreas de parque</strong></div><div><small>Ubicación</small><strong>Mercedes, Buenos Aires</strong></div></div></div><aside class="hero-portal"><small><span class="live-dot"></span>Ahora en La Niña</small><strong>Tu pequeña base de campo.</strong><div class="hero-portal-grid"><div><small>Clima</small><span data-weather>—</span></div><div><small>Pileta</small><span>Verano</span></div><a href={`${base}estadia/`}><small>Huéspedes</small><span>Abrir guía →</span></a><a href={mapsHref} target="_blank" rel="noreferrer"><small>Llegar</small><span>Abrir Maps →</span></a></div></aside></section>
<section class="trust-strip"><div class="shell trust-grid"><a class="rating" href={mapsHref} target="_blank" rel="noreferrer"><span class="stars">★★★★★</span><strong>4,5 en Google</strong><span>260 opiniones · ver ficha ↗</span></a><p>Un complejo chico, atendido de manera directa, a pocos kilómetros del centro de Mercedes.</p></div></section>
<section class="intro" id="lugar"><div class="shell intro-grid"><div class="section-kicker">La Niña · desde  el campo</div><div><h2 class="display">Un lugar para llegar y bajar un cambio.</h2><p class="intro-copy">Cabañas independientes, árboles, pileta en verano y mucho parque. La propuesta es deliberadamente simple: tener espacio, cocinar algo, desayunar sin apuro y dejar que el día se arme solo.</p></div></div></section>
<section class="property-showcase" aria-label="Conocé La Niña"><div class="property-track" data-property-track>{propertyImages.map((item,i)=><figure class="property-slide"><img src={item.src} alt={`${item.label} en Cabañas La Niña`} loading={i===0?'eager':'lazy'}/><figcaption><span>0{i+1} · {item.label}</span><strong>{item.copy}</strong></figcaption></figure>)}</div><div class="property-controls"><button type="button" data-property-prev aria-label="Foto anterior">←</button><span data-property-count>01 / 04</span><button type="button" data-property-next aria-label="Foto siguiente">→</button></div><div class="property-signature"><img src={`${base}logo.svg`} alt=""/><span>La Niña<br/><small>un poco de campo</small></span></div></section>
<section class="story-grid"><div class="story-photo"><img src={interior} alt="Interior de una cabaña de La Niña" loading="lazy"/></div><div class="story-panel"><div><div class="section-kicker section-kicker-light">Adentro</div><h2>Rústicas, cálidas y pensadas para quedarse.</h2><p>Espacios independientes con cocina, aire acondicionado, Wi‑Fi y parrilla. Lo necesario para hacer base, descansar y volver al parque.</p></div></div></section>
<section class="features" id="servicios"><div class="shell"><div class="features-head"><div><div class="section-kicker">Lo esencial</div><h2 class="display">Más lugar para hacer menos.</h2></div><p class="features-note">La experiencia de La Niña primero: parque, independencia y comodidades simples para que el fin de semana no tenga demasiada agenda.</p></div><div class="feature-list"><article class="feature"><div class="num">01</div><h3>Parque</h3><p>Dos hectáreas de verde para pasar buena parte del día afuera.</p></article><article class="feature"><div class="num">02</div><h3>Pileta</h3><p>Piscina al aire libre durante la temporada de verano.</p></article><article class="feature"><div class="num">03</div><h3>Parrilla</h3><p>Un lugar propio para cocinar al fuego y comer sin horarios.</p></article><article class="feature"><div class="num">04</div><h3>Comodidad</h3><p>Wi‑Fi, cocina, estacionamiento y aire acondicionado.</p></article></div><aside class="pet-note"><div class="pet-mark" aria-hidden="true">✦</div><div><div class="section-kicker">Venís con compañía</div><h3>Mascotas, con consulta previa.</h3><p>Avisanos antes de reservar para coordinar la estadía y confirmar que funcione bien para todos.</p></div><a class="text-link" href={whatsappHref} target="_blank" rel="noreferrer">Consultar por WhatsApp →</a></aside></div></section>
<section class="breakfast" id="desayuno"><div class="breakfast-gallery"><div class="breakfast-track" data-breakfast-track>{breakfastImages.map((src,i)=><figure><img src={src} alt={`Desayuno — imagen conceptual ${i+1}`} loading="lazy"/></figure>)}</div><div class="breakfast-controls"><button type="button" data-breakfast-prev aria-label="Foto anterior">←</button><span data-breakfast-count>01 / 03</span><button type="button" data-breakfast-next aria-label="Foto siguiente">→</button></div><div class="breakfast-stamp"><span>LA NIÑA</span><strong>AM</strong><small>sin apuro</small></div></div><div class="breakfast-copy"><div class="section-kicker">Opcional · hecho en casa</div><h2>Mañanas<br/><em>sin apuro.</em></h2><p class="breakfast-lede">Podés sumar desayuno: panadería hecha en casa, café, té, jugo de naranja y yogur griego con frutas y frutos secos.</p><div class="breakfast-menu"><span>Panadería artesanal</span><span>Café & té</span><span>Jugo de naranja</span><span>Yogur · frutas · frutos secos</span></div><span class="provisional">Horario tentativo 08:30—11:30 · a corroborar</span></div></section>
<section class="proof"><div class="shell"><div class="proof-head"><div><div class="section-kicker section-kicker-light">Lo dicen quienes vinieron</div><h2>Lo que queda después de la estadía.</h2></div><p>La ficha pública de Google muestra 4,5 sobre 5 con 260 opiniones. Naturaleza, tranquilidad y atención aparecen una y otra vez en los comentarios.</p></div><div class="review-grid"><article class="review-card"><div class="review-stars">★★★★★</div><blockquote>“Excelente lugar rodeado de naturaleza, paz atendido por sus dueños muy cordiales.”</blockquote><small>Patricia Frasch · Google</small></article><article class="review-card"><div class="review-stars">★★★★★</div><blockquote>“Bellísimo lugar… la piscina es hermosa, el parque muy bien cuidado.”</blockquote><small>Carmen E · Tripadvisor · marzo 2026</small></article><article class="review-card"><div class="review-stars">★★★★★</div><blockquote>“Un lugar bello para descansar… y por favor el desayuno.”</blockquote><small>Laura Hebe C · Tripadvisor · enero 2025</small></article></div><div class="proof-links"><a href={mapsHref} target="_blank" rel="noreferrer">Ver opiniones en Google ↗</a><a href="https://www.tripadvisor.com.ar/Hotel_Review-g312750-d15528549-Reviews-Cabanas_la_Nina-Mercedes_Province_of_Buenos_Aires_Central_Argentina.html" target="_blank" rel="noreferrer">Tripadvisor ↗</a></div></div></section>
<section class="guest-preview"><div class="guest-preview-copy"><div class="section-kicker">Cuando ya estás acá</div><h2>La web también sirve durante la estadía.</h2><p>Clima, desayuno, pileta, supermercados, farmacia, combustible, restaurantes y rutas directas desde La Niña.</p><div class="guest-mini"><span><small>Hoy</small><strong><span data-weather>Mercedes · ahora</span></strong></span><span><small>Desayuno</small><strong>~08:30—11:30 · a confirmar</strong></span><span><small>Pileta</small><strong>Temporada de verano</strong></span></div><a class="button button-dark" href={`${base}estadia/`}>Abrir guía del huésped</a></div></section>
<section class="discover discover-late" id="descubrir"><div class="shell discover-head"><div><div class="section-kicker">Después, el mundo alrededor</div><h2 class="display">Mercedes también es parte de la escapada.</h2></div><div class="discover-intro"><p>Cuando ya conociste La Niña: mesas, historias y lugares elegidos para completar el fin de semana.</p><a class="text-link" href={`${base}guia/`}>Abrir el cuaderno de Mercedes →</a></div></div><div class="shell late-stories">{featuredStories.slice(0,3).map((story,index)=><article><a href={`${base}guia/${story.slug}/`}><img src={story.image} alt={story.imageAlt} loading="lazy"/><span>0{index+1} · {story.eyebrow}</span><h3>{story.title}</h3></a></article>)}</div></section>
<section class="location" id="ubicacion"><div class="shell location-grid"><div><div class="section-kicker">Mercedes, Buenos Aires</div><h2 class="display location-title">Campo sin irse demasiado lejos.</h2><p>Un entorno rural a pocos kilómetros del centro y una buena base para descubrir Mercedes y Tomás Jofré.</p><a class="text-link" href={mapsHref} target="_blank" rel="noreferrer">Cómo llegar en Google Maps →</a></div><div class="address-card"><small>La Niña</small><strong>Calle 151 entre 28 Bis y 30 Bis<br/>Mercedes, Buenos Aires</strong><a href={mapsHref} target="_blank" rel="noreferrer">Abrir ubicación exacta ↗</a></div></div></section>
<section class="contact" id="contacto"><div class="shell"><div class="contact-grid"><div><div class="section-kicker section-kicker-light">Tu próxima pausa</div><h2 class="display contact-title">¿Cuándo te querés escapar?</h2></div><div><p>Disponibilidad, mascotas y consultas se coordinan directamente con La Niña.</p><div class="contact-actions"><a class="button button-primary" href={whatsappHref} target="_blank" rel="noreferrer">Escribir por WhatsApp</a><a class="text-link text-link-light" href={phoneHref}>o llamar al {phoneDisplay}</a></div></div></div><footer class="footer"><div><img src={`${base}logo.svg`} alt="Cabañas La Niña"/><div class="footer-place">Mercedes · Provincia de Buenos Aires · Argentina</div></div><div>Campo · descanso · Mercedes</div></footer></div></section></main>
<a class="mobile-whatsapp" href={whatsappHref} target="_blank" rel="noreferrer" aria-label="Consultar disponibilidad por WhatsApp"><span>Consultar</span><strong>WhatsApp</strong></a>
<script is:inline>
(()=>{
 const carousel=(trackSel,prevSel,nextSel,countSel,delay)=>{const t=document.querySelector(trackSel);if(!t)return;const s=[...t.children],c=document.querySelector(countSel);let i=0,timer;const sync=()=>{if(c)c.textContent=`${String(i+1).padStart(2,'0')} / ${String(s.length).padStart(2,'0')}`};const go=n=>{i=(n+s.length)%s.length;t.scrollTo({left:t.clientWidth*i,behavior:'smooth'});sync()};document.querySelector(prevSel)?.addEventListener('click',()=>go(i-1));document.querySelector(nextSel)?.addEventListener('click',()=>go(i+1));t.addEventListener('scroll',()=>{i=Math.round(t.scrollLeft/Math.max(1,t.clientWidth));sync()},{passive:true});if(delay&&!matchMedia('(prefers-reduced-motion: reduce)').matches){timer=setInterval(()=>go(i+1),delay);t.addEventListener('pointerdown',()=>clearInterval(timer),{passive:true})}};
 carousel('[data-property-track]','[data-property-prev]','[data-property-next]','[data-property-count]',6500);carousel('[data-breakfast-track]','[data-breakfast-prev]','[data-breakfast-next]','[data-breakfast-count]',5000);
 const targets=document.querySelectorAll('[data-weather]');if(targets.length)fetch('https://api.open-meteo.com/v1/forecast?latitude=-34.649883&longitude=-59.3869273&current=temperature_2m,weather_code&timezone=America%2FArgentina%2FBuenos_Aires').then(r=>r.json()).then(d=>{const c=d.current||{},code=c.weather_code,label=code===0?'Despejado':code<=3?'Algo nublado':code<=67?'Lluvia':code<=82?'Chaparrones':'Variable';targets.forEach(el=>el.textContent=`${Math.round(c.temperature_2m)}° · ${label}`)}).catch(()=>{});
})();
</script></body></html>